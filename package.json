{
  "name": "keyborg",
  "version": "3.498.0-canary.0",
  "description": "Keyboard Navigation Detection for Web",
  "author": "Marat Abdullin <marata@microsoft.com>",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "typings": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/microsoft/keyborg"
  },
  "scripts": {
    "build": "tsdown",
    "bundle-size": "yarn build && monosize measure",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "test": "playwright test",
    "test:serve": "storybook dev --port 3000 --no-open",
    "lint": "eslint src/ tests/",
    "lint:fix": "yarn lint --fix",
    "prepublishOnly": "yarn lint && yarn format && yarn build",
    "release": "release-it"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@storybook/react-vite": "^10.6.1",
    "@types/prop-types": "^15.7.15",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "monosize": "^0.10.0",
    "monosize-bundler-webpack": "^0.4.1",
    "monosize-storage-git": "^0.3.5",
    "playwright": "^1.64.0",
    "prettier": "^3.9.10",
    "prop-types": "^15.8.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-shadow": "^20.6.0",
    "release-it": "^21.1.1",
    "storybook": "^10.6.2",
    "tsdown": "^0.23.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4"
  },
  "resolutions": {
    "get-uri/basic-ftp": "6.2.3"
  },
  "packageManager": "yarn@4.18.1+sha512.b2e1e7524f654f2749d32b4ebcb4622473cb5bcbc485df2007e12a154e50162a4d795526768bc5f5b8f81717bfd79deb2472813d86fb5ae2eb551fa9c872b08f"
}
