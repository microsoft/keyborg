{
  "name": "keyborg",
  "version": "3.0.0",
  "description": "Keyboard Navigation Detection for Web",
  "author": "Marat Abdullin <marata@microsoft.com>",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "typings": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/microsoft/keyborg"
  },
  "scripts": {
    "build": "tsdown",
    "bundle-size": "yarn build && monosize measure",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "test": "playwright test",
    "test:serve": "storybook dev --port 3000 --no-open",
    "lint": "eslint src/ tests/",
    "lint:fix": "yarn lint --fix",
    "prepublishOnly": "yarn lint && yarn format && yarn build",
    "release": "release-it"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@storybook/react-vite": "^10.5.10",
    "@types/prop-types": "^15.7.15",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "monosize": "^0.10.0",
    "monosize-bundler-webpack": "^0.4.1",
    "monosize-storage-git": "^0.3.5",
    "playwright": "^1.63.0",
    "prettier": "^3.9.6",
    "prop-types": "^15.8.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-shadow": "^20.6.0",
    "release-it": "^21.0.2",
    "storybook": "^10.5.10",
    "tsdown": "^0.22.14",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2"
  },
  "packageManager": "yarn@4.18.0+sha224.5707fce90df5d8720fae4e85a07ab55e90aa20fded8914893e2ba225"
}
